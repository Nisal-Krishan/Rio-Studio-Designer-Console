{
  "name": "rio-studio-designers",
  "version": "3.7.0",
  "description": "Rio Studio Private Limited — Billing & Design POS by Zirac AI Solution",
  "author": "Nisal Krishan - Zirac AI Solution",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:setup": "npm run build:icon && node scripts/clean-dist.js && electron-builder --win nsis --x64",
    "build:icon": "node scripts/build-icon.js"
  },
  "build": {
    "appId": "com.ziracai.rio.studio.designers",
    "productName": "Rio Studio Designers",
    "copyright": "Copyright © 2026 Rio Studio Private Limited · Zirac AI Solution",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "Zirac AI Solution",
      "artifactName": "Rio-Studio-Designers-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rio Studio Designers",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "license": "build/license.txt",
      "displayLanguageSelector": false
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "script.js",
      "vendor/**/*",
      "build/icon.ico",
      "build/icon.png"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
